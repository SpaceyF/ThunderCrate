<Window x:Class="ThunderCrate.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ThunderCrate" Height="560" Width="620"
        WindowStartupLocation="CenterScreen"
        Background="#14161c" Foreground="#e6e8ee"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#232733"/>
            <Setter Property="Foreground" Value="#e6e8ee"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="⚡" FontSize="26" Margin="0,0,10,0"/>
            <StackPanel>
                <TextBlock Text="ThunderCrate" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusLine" Text="listening…" Foreground="#8b93a7" FontSize="12"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Background="#1a1d26" CornerRadius="9" Padding="14" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="MODS FOLDER" Foreground="#8b93a7" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock x:Name="ModsPathText" Text="" TextWrapping="Wrap" Margin="0,4,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Change folder" Click="OnSetFolder"/>
                    <Button Content="Open folder" Click="OnOpenFolder" Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="#1a1d26" CornerRadius="9" Padding="14" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="RECENT INSTALLS" Foreground="#8b93a7" FontSize="11" FontWeight="SemiBold"/>
                <ItemsControl x:Name="RecentList" Margin="0,6,0,0"/>
                <TextBlock x:Name="RecentEmpty" Text="nothing yet — hit Subscribe on a Thunderstore page"
                           Foreground="#5c6377" FontSize="12"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" Text="LOG" Foreground="#8b93a7" FontSize="11" FontWeight="SemiBold" Margin="2,14,0,4"/>
        <Border Grid.Row="4" Background="#0f1116" CornerRadius="9" Padding="10">
            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="12" Foreground="#a9d0c0"
                           TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
